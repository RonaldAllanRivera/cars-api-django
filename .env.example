# =============================================================================
# Cars Images API (Django) - environment
#
# Copy to .env for local development:  cp .env.example .env
# Names match the original Laravel project, so its .env translates directly.
# Placeholders only - never commit real secrets. Production values live in the
# Render, Netlify and GitHub dashboards (see DEPLOYMENT.md).
# =============================================================================

APP_NAME="Cars Images API"
# local | production. `local` turns APP_DEBUG on unless it is set explicitly.
APP_ENV=local
# Django SECRET_KEY. Must be non-empty. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
APP_KEY=django-insecure-local-development-key-change-me
APP_DEBUG=true
# Public base URL: signed export links are built from it, and its host is added
# to ALLOWED_HOSTS. Production: https://<service>.onrender.com
APP_URL=http://localhost:8000

# Comma-separated. Defaults to * when APP_DEBUG is true and to nothing otherwise
# (APP_URL's host and Render's RENDER_EXTERNAL_HOSTNAME are always added).
# ALLOWED_HOSTS=localhost,127.0.0.1
# Set automatically by Render; do not set by hand.
# RENDER_EXTERNAL_HOSTNAME=

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Docker Compose only (ignored when running without Docker)
#   APP_PORT        host port mapped to the API container
#   FORWARD_DB_PORT host port PostgreSQL is published on, for GUI clients
# ---------------------------------------------------------------------------
APP_PORT=8000
FORWARD_DB_PORT=5434

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
#
# These values reach the Compose database on its published port, for running
# the backend without Docker. Inside Compose the api service overrides
# DB_HOST=db and DB_PORT=5432 itself.
# Production (Neon): the host, user and password from the Neon dashboard, with
# DB_SSLMODE=require. Use the direct host, not the "-pooler" one.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=cars_images_api
DB_USERNAME=cars_images_api
DB_PASSWORD=secret
# disable | allow | prefer | require | verify-ca | verify-full. Empty for local.
DB_SSLMODE=
# Seconds to keep a connection open between requests (0 closes after each).
DB_CONN_MAX_AGE=60
# Optional. When set it wins over every DB_* value above, e.g.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=
# Tests only: a separate test database name, so parallel runs do not collide.
# DB_TEST_DATABASE=test_cars_images_api

# database = Django's database cache (needs `manage.py createcachetable`, which
# the container runs on start). Anything else = per-process memory cache.
CACHE_STORE=database

# ---------------------------------------------------------------------------
# CORS - browser origins allowed to call /api/* (comma-separated, no trailing
# slash). Local: the Vue dev server and the Expo web dev server.
# Production: both Netlify origins, e.g.
# CORS_ALLOWED_ORIGINS=https://cars-images-web.netlify.app,https://cars-images-mobile.netlify.app
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ---------------------------------------------------------------------------
# Admin account - created or updated on every container start by
# `manage.py ensure_admin` (Render's free tier has no shell for createsuperuser).
# Leave both empty to skip. The environment wins: a password changed in the
# admin UI is reset to ADMIN_PASSWORD on the next boot. Weak passwords are
# rejected and stop the boot.
# ---------------------------------------------------------------------------
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Wikimedia Commons
#
# WIKIMEDIA_USER_AGENT must identify the deployment and give a REAL contact URL
# or email. Wikimedia's User-Agent policy answers generic agents with 403/429.
# ---------------------------------------------------------------------------
WIKIMEDIA_BASE_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_USER_AGENT="CarsImagesApi/1.0 (https://example.com; admin@example.com)"
WIKIMEDIA_TIMEOUT=10
WIKIMEDIA_RETRY_TIMES=3
WIKIMEDIA_RETRY_SLEEP_MS=200
WIKIMEDIA_CACHE_TTL=3600
WIKIMEDIA_MAXLAG=5
# Category resolution: how long a "no category found" result is cached, and how
# many files one category listing may page through.
WIKIMEDIA_CATEGORY_MISS_TTL_DAYS=30
WIKIMEDIA_CATEGORY_MAX_FILES=500
WIKIMEDIA_CATEGORY_PAGE_SIZE=200

# ---------------------------------------------------------------------------
# CSV imports
# ---------------------------------------------------------------------------
CSV_IMPORT_MAX_COMBOS=1000
CSV_IMPORT_DEFAULT_IMAGES_PER_YEAR=5
CSV_IMPORT_MAX_UPLOAD_KB=5120
# Hard cap on Wikimedia image downloads one CSV may commit to
# (unique queries x CSV_IMPORT_DEFAULT_IMAGES_PER_YEAR).
CSV_IMPORT_MAX_PROJECTED_IMAGES=5000

# ---------------------------------------------------------------------------
# Pipeline error log
# Nothing prunes on a schedule (no cron on the free tier): old rows go when the
# "Prune old entries" button in the admin or `manage.py prune_error_events` runs.
# The per-import cap stops one bad upload writing thousands of rows.
# ---------------------------------------------------------------------------
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_MAX_EVENTS_PER_IMPORT=500

# ---------------------------------------------------------------------------
# Bulk runs, downloads and exports
# Everything runs inside the request, so these caps keep a request short.
# ---------------------------------------------------------------------------
CARS_BULK_RUN_MAX_QUERIES=50
CARS_BULK_RUN_MAX_SECONDS=50
# Target length of one client-driven chunk (POST /searches/run-chunk).
CARS_BULK_RUN_AUTO_CHUNK_SECONDS=10
CARS_BULK_RUN_SLEEP_SECONDS=1

CARS_DOWNLOAD_MAX_WIDTH=1600
CARS_DOWNLOAD_JPEG_QUALITY=82
CARS_BULK_DOWNLOAD_MAX_IMAGES=100

# Lifetime of a signed, single-use export download link.
EXPORT_LINK_TTL_SECONDS=300

# JSON API: caps on one inline search.
API_SEARCH_MAX_YEAR_SPAN=3
API_SEARCH_MAX_IMAGES_PER_YEAR=5

# ---------------------------------------------------------------------------
# Gunicorn (container only; defaults suit a 512 MB instance)
# ---------------------------------------------------------------------------
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=180

# ---------------------------------------------------------------------------
# Clients - inlined into the JavaScript bundle at build time, so not secret.
# In CI these are GitHub repository *variables* (not secrets).
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Deployment - documented here for reference only. They belong in GitHub
# (Settings -> Secrets and variables -> Actions), never in a committed file.
#   Secrets:   NETLIFY_AUTH_TOKEN, NETLIFY_SITE_ID (mobile), NETLIFY_WEB_SITE_ID (web)
#   Variables: MOBILE_DEPLOY_ENABLED, WEB_DEPLOY_ENABLED ('true' to deploy),
#              VITE_API_URL, EXPO_PUBLIC_API_URL
# ---------------------------------------------------------------------------
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# NETLIFY_WEB_SITE_ID=
# MOBILE_DEPLOY_ENABLED=false
# WEB_DEPLOY_ENABLED=false
